{
  "name": "fleetworkslog",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "web",
    "mobile"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "npm run build --workspace=shared",
    "dev": "concurrently --names shared,backend,web --prefix-colors gray,blue,green \"npm run dev --workspace=shared\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=web\"",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=shared && npm run build --workspace=backend && npm run build --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:rollback": "npm run db:rollback --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:status": "npm run db:status --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "install:all": "npm install",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
